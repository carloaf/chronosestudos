APP_NAME=ChronosEstudos
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── Database ─────────────────────────────────
DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=chronosestudos
DB_USERNAME=chronos
DB_PASSWORD=chronos_secret

# ── Session / Cache ──────────────────────────
BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# ── Mail (placeholder) ───────────────────────
MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@chronosestudos.local"
MAIL_FROM_NAME="${APP_NAME}"



